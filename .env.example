# ZS Events CRM - environment settings
#
# Copy to .env.local for local development (never commit it; .env* is gitignored).
# Production values live in Vercel: vercel env ls --scope zs-events
# Add or change one: vercel env add NAME production --scope zs-events, then redeploy.
# Leave the Supabase values empty locally to run on built-in sample data.

# --- Database and sign-in (Supabase project dzghfcqijwlqwxrjhvpr) ---
# Server only. The secret key bypasses Row Level Security: never expose it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Browser (sign-in only). Safe to expose: publishable keys only work within the RLS rules.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Who may use the CRM ---
# Users need app_metadata.crm_access = true in Supabase, or their email listed here (comma separated).
CRM_ALLOWED_EMAILS=

# --- Extra websites allowed to call the API (comma separated, optional) ---
# crm.zsevents.in, zsevents.in and www.zsevents.in are always allowed.
ALLOWED_ORIGINS=

# --- Website enquiry email alerts (optional; enquiries are saved even without these) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail App Password (16 characters), not the account password
SMTP_PASS=
# Where alerts go (defaults to SMTP_USER)
INQUIRY_NOTIFY_TO=

# --- Error tracking (optional) ---
SENTRY_DSN=

# --- Local development only: one-click demo sign-in. Never set these in Vercel. ---
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
